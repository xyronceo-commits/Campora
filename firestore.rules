rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['isAdmin', 'isVerifiedAgent', 'verificationStatus']);
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isVerifiedAgent', 'verificationStatus', 'role']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Listings Collection
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.agentId == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['isAgentVerified', 'isFeatured']));
      allow update: if (isAuthenticated() && resource.data.agentId == request.auth.uid && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAgentVerified', 'isFeatured'])) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.agentId == request.auth.uid) || isAdmin();
    }

    // Inspection Bookings Collection
    match /inspections/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.agentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.agentId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Agent Verifications Collection
    match /verifications/{verifId} {
      allow read: if isAuthenticated() && (resource.data.agentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.agentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
